CTestTestfile.cmake
Makefile
compile_commands.json
.cache/

# IDE / editor
.idea/                # CLion / IntelliJ
.vscode/
.vs/                  # Visual Studio
*.swp                 # Vim

# Compiled objects and debug symbols
*.o
*.obj
*.exe
*.dSYM/                # macOS debug symbols
*.pdb                  # Windows debug symbols
*.ilk

# macOS
**/.DS_Store

# Windows
Thumbs.db
desktop.ini

# Linux
*~

# Python (scripts/png_to_ico.py)
__pycache__/
*.pyc

# Local environment / secrets
.env