    "id": "quick_sort",
    "name": "Quick Sort",
    "display_type": "Quick Sort",
    "category": "Sorting",
    "version": "1.0.0",
    "last_updated": "2026-03-02",
    
    "complexity": {
      "time_best": "O(n log n)",
      "time_average": "O(n log n)",
      "time_worst": "O(n²)",
      "space": "O(log n)",
      "explanation": "Quick Sort is a divide-and-conquer algorithm. It works by selecting a 'pivot' element and partitioning the array around it. The worst case occurs when the pivot is always the smallest or largest element."
    },
    
    "properties": {
      "stable": false,
      "in_place": true,
      "adaptive": false,
      "comparison_based": true,
      "online": false,
      "recursive": true,
      "parallelizable": true,
      "deterministic": false
    },
    
    "description": {
      "brief": "An efficient divide-and-conquer sorting algorithm that works by selecting a 'pivot' element and partitioning the array around it.",
      
      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity:",
        "• Best case:    O(n log n) - when pivot divides array evenly",
        "• Average case: O(n log n) - random data",
        "• Worst case:   O(n²)      - when array is already sorted (naive pivot)",
        "",
        "Space Complexity: O(log n) - due to recursion stack",
        "",
        "Key Characteristics:",
        "• Divide-and-conquer strategy",
        "• In-place sorting (no extra array needed)",
        "• Not stable (relative order may change)",
        "• Cache-friendly due to sequential access",
        "",
        "Performance Metrics:",
        "• Comparisons: O(n log n) average",
        "• Swaps: O(n log n) average",
        "• Recursion depth: O(log n) average, O(n) worst"
      ],
      
      "pseudocode": [
        "void quick_sort(vector<int>& arr, int low, int high)",
        "{",
        "     if (low < high)",
        "     {",
        "         int pi = partition(arr, low, high);",
        "",
        "         quick_sort(arr, low, pi - 1);",
        "         quick_sort(arr, pi + 1, high);",
        "     }",
        "}",
        "",
        "int partition(vector<int>& arr, int low, int high)",
        "{",
        "     int pivot = arr[high];",
        "     int i = low - 1;",
        "",
        "     for (int j = low; j <= high - 1; j++)",
        "     {",
        "         if (arr[j] <= pivot)",
        "         {",
        "             i++;",
        "             swap(arr[i], arr[j]);",
        "         }",
        "     }",
        "",
        "     swap(arr[i + 1], arr[high]);",
        "     return i + 1;",
        "}"
      ],
      
      "optimizations": [
        "Median-of-three pivot selection",
        "Randomized pivot selection",
        "Hybrid with insertion sort for small subarrays",
        "Tail recursion optimization",
        "Introsort (switches to heap sort for worst-case)"
      ],
      
      "use_cases": [
        "General-purpose sorting in standard libraries",
        "Large datasets",
        "When average-case performance matters more than worst-case",
        "When in-place sorting is required"
      ],
      
      "disadvantages": [
        "Not stable",
        "Worst-case O(n²) with poor pivot selection",
        "Recursive implementation may cause stack overflow",
        "Not suitable for nearly sorted arrays (with naive pivot)"
      ],
      
      "related_algorithms": [
        "Merge Sort",
        "Heap Sort",
        "Introsort",
        "Tim Sort"
      ]
    },
    
