      "time_worst": "O(E log V)",
      "space": "O(V)",
      "explanation": "Best-First Search uses a priority queue with heuristic function. Time complexity is O(E log V) where E is edges and V is vertices. Space complexity is O(V) for the open set and visited tracking."
    },

    "properties": {
      "stable": true,
      "in_place": false,
