      "comparison_based": true,
      "online": false,
      "recursive": false,
      "parallelizable": false,
      "deterministic": true
    },

    "description": {
      "brief": "Greedy Best-First Search uses only the heuristic to guide the search toward the target, making it very fast but not guaranteed to find the shortest path.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O(E log V) with binary heap",
        "Space Complexity: O(V) for open set and visited tracking",
        "",
        "Key Characteristics:",
        "• Uses only heuristic to prioritize nodes",
        "• Very fast, especially with good heuristic",
        "• Does NOT guarantee shortest path",
        "• Can be seen as A* without the g-score component",
        "",
        "Applications:",
        "• Real-time pathfinding when optimality isn't critical",
        "• Game AI where speed is priority",
        "• Preliminary path estimation",
        "• Search problems with good heuristics"
      ],

      "pseudocode": [
        "vector<Cell> BestFirstSearch(",
        "       const Grid& grid,",
        "       Cell start,",
        "       Cell target)",
        "{",
        "    PriorityQueue<Cell, float> open_set;",
        "    vector<vector<bool>> visited(rows, vector<bool>(cols, false));",
        "    vector<vector<bool>> in_open(rows, vector<bool>(cols, false));",
        "    vector<vector<Cell>> came_from(rows, vector<Cell>(cols));",
        "",
        "    open_set.push(start, heuristic(start, target));",
        "    in_open[start.row][start.col] = true;",
        "",
        "    while (!open_set.empty())",
        "    {",
        "        Cell current = open_set.pop_min();",
        "        in_open[current.row][current.col] = false;",
        "        visited[current.row][current.col] = true;",
        "",
        "        if (current == target)",
        "        {",
        "            break;",
        "        }",
        "",
        "        for (const Cell& neighbor : get_neighbors(current))",
        "        {",
        "            if (visited[neighbor.row][neighbor.col]) continue;",
        "            if (grid[neighbor.row][neighbor.col] == WALL) continue;",
        "",
        "            if (!in_open[neighbor.row][neighbor.col])",
        "            {",
        "                came_from[neighbor.row][neighbor.col] = current;",
        "                float h = heuristic(neighbor, target);",
        "                open_set.push(neighbor, h);",
        "                in_open[neighbor.row][neighbor.col] = true;",
        "            }",
        "        }",
        "    }",
        "",
        "    return reconstruct_path(came_from, start, target);",
        "}"
      ],

      "optimizations": [
        "Tie-breaking strategies for consistent behavior",
        "Bidirectional Best-First Search",
        "Dynamic weighting for improved path quality",
        "Memory-efficient visited tracking"
      ],

      "use_cases": [
        "Real-time strategy game unit movement",
        "Rapid path estimation",
        "Search problems with informative heuristics",
        "Prototyping before implementing A*"
      ],

      "disadvantages": [
        "Does NOT guarantee shortest path",
        "Can get stuck in local minima",
        "Path quality highly depends on heuristic",
        "May explore many nodes in open areas"
      ],

      "related_algorithms": [
