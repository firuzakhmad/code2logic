      "deterministic": true
    },

    "description": {
      "brief": "Depth-First Search (DFS) is a graph traversal algorithm that explores as far as possible along each branch before backtracking.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O(V + E) - visit each vertex and edge once",
        "Space Complexity: O(V) - for recursion stack or explicit stack",
        "",
        "Key Characteristics:",
        "• Explores graph depth-first before backtracking",
        "• Uses stack (recursion) for traversal",
        "• Can be used for topological sorting",
        "• Detects cycles in directed graphs",
        "",
        "Applications:",
        "• Topological sorting",
        "• Cycle detection",
        "• Finding connected components",
        "• Maze solving",
        "• Path finding"
      ],

      "pseudocode": [
        "void DFS(",
        "       const Graph& graph,",
        "       size_t start_node,",
        "       optional<size_t> target_node)",
        "{",
        "    Stack<size_t> stack;",
        "    vector<bool> visited(graph.node_count, false);",
        "    vector<bool> in_stack(graph.node_count, false);",
        "    vector<size_t> parent(graph.node_count, INVALID_NODE);",
        "    vector<int> distance(graph.node_count, -1);",
        "    vector<int> entry_time(graph.node_count, -1);",
        "    vector<int> exit_time(graph.node_count, -1);",
        "    int time_counter = 0;",
        "",
        "    stack.push(start_node);",
        "    in_stack[start_node] = true;",
        "    distance[start_node] = 0;",
        "",
        "    while (!stack.empty())",
        "    {",
        "        size_t current_node = stack.top();",
        "        stack.pop();",
        "        in_stack[current_node] = false;",
        "",
        "        if (!visited[current_node])",
        "        {",
        "            visited[current_node] = true;",
        "            entry_time[current_node] = time_counter++;",
        "",
        "            if (target_node.has_value() &&",
        "                current_node == target_node.value())",
        "            {",
        "                break;",
        "            }",
        "",
        "            for (size_t neighbor : graph.adjacencyList[current_node])",
        "            {",
        "                if (!visited[neighbor] && !in_stack[neighbor])",
        "                {",
        "                    stack.push(neighbor);",
        "                    in_stack[neighbor] = true;",
        "                    parent[neighbor] = current_node;",
        "                    distance[neighbor] = distance[current_node] + 1;",
        "                }",
        "            }",
        "",
        "            exit_time[current_node] = time_counter++;",
        "        }",
        "    }",
        "}"
      ],

      "optimizations": [
        "Iterative implementation to avoid recursion limits",
        "Early termination when target found",
        "Color-coded node states for visualization",
        "Explicit stack for better performance"
      ],

      "use_cases": [
        "Topological sorting",
        "Cycle detection in graphs",
        "Finding connected components",
        "Maze generation and solving",
        "Puzzle solving",
        "Path existence checking"
      ],

      "disadvantages": [
        "May not find shortest path",
        "Recursive implementation can cause stack overflow",
        "Can get stuck in deep graphs",
        "Not suitable for infinite graphs"
      ],

      "related_algorithms": [
        "Breadth-First Search (BFS)",
        "Topological Sort",
        "Kosaraju's Algorithm",
        "Tarjan's Algorithm"
      ]
    },

