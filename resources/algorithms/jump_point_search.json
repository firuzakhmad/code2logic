  "algorithm": {
    "id": "jump_point_search",
    "name": "Jump Point Search (JPS)",
    "display_type": "Jump Point Search",
    "category": "Path Finding",
    "version": "1.0.0",
    "last_updated": "2026-05-19",

    "complexity": {
      "time_best": "O(n)",
      "time_average": "O(kn) where k << V",
      "time_worst": "O(V log V)",
      "space": "O(V)",
      "explanation": "JPS uses symmetry reduction to prune redundant paths. In practice, it's much faster than A* on uniform grids as it only evaluates 'jump points' - nodes where direction changes are forced."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": false,
      "comparison_based": true,
      "online": false,
      "recursive": true,
      "parallelizable": false,
      "deterministic": true
    },

    "description": {
      "brief": "Jump Point Search is an optimization of A* for uniform-cost grids that dramatically reduces the number of nodes evaluated by 'jumping' over large sections of open space.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O(n) to O(V log V) depending on grid structure",
        "Space Complexity: O(V) for open/closed sets and jump points",
        "",
        "Key Characteristics:",
        "• Uses symmetry breaking to prune redundant paths",
        "• Only considers 'jump points' - nodes where direction changes",
        "• Can skip large areas of uniform terrain in one step",
        "• Up to 10x faster than A* on open grids",
        "",
        "Applications:",
        "• Real-time strategy games",
        "• Large-scale grid navigation",
        "• Robotics path planning in open environments",
        "• Video game AI movement"
      ],

      "pseudocode": [
        "vector<Cell> JumpPointSearch(",
        "       const Grid& grid,",
        "       Cell start,",
        "       Cell target)",
        "{",
        "    PriorityQueue<Cell> open_set;",
        "    vector<vector<bool>> closed_set(rows, vector<bool>(cols, false));",
        "    vector<vector<Cell>> came_from(rows, vector<Cell>(cols));",
        "    vector<vector<float>> g_score(rows, vector<float>(cols, INFINITY));",
        "",
        "    g_score[start.row][start.col] = 0;",
        "    open_set.push(start, heuristic(start, target));",
        "",
        "    while (!open_set.empty())",
        "    {",
        "        Cell current = open_set.pop_min();",
        "",
        "        if (current == target)",
        "        {",
        "            break;",
        "        }",
        "",
        "        closed_set[current.row][current.col] = true;",
        "",
        "        // Get pruned neighbors (only jump points)",
        "        for (Cell neighbor : get_jump_points(current))",
        "        {",
        "            if (closed_set[neighbor.row][neighbor.col]) continue;",
        "",
        "            float tentative_g = g_score[current.row][current.col] +",
        "                distance(current, neighbor);",
        "",
        "            if (tentative_g < g_score[neighbor.row][neighbor.col])",
        "            {",
        "                came_from[neighbor.row][neighbor.col] = current;",
        "                g_score[neighbor.row][neighbor.col] = tentative_g;",
        "                float f_score = tentative_g + heuristic(neighbor, target);",
        "                open_set.push(neighbor, f_score);",
        "            }",
        "        }",
        "    }",
        "",
        "    return reconstruct_path(came_from, start, target);",
        "}",
        "",
        "function jump(Cell from, Direction dir):",
        "    Cell next = from + dir;",
        "    if (next is wall) return null;",
        "    if (next == target) return next;",
        "    if (has_forced_neighbor(next, dir)) return next;",
        "    if (dir.is_diagonal())",
        "        if (jump(next, dir.horizontal) || jump(next, dir.vertical))",
        "            return next;",
        "    return jump(next, dir);"
      ],

      "optimizations": [
        "Recursive jump point identification",
        "Forced neighbor detection for path pruning",
        "Directional pruning for symmetry breaking",
        "Early termination on target detection"
      ],

      "use_cases": [
        "Large open world game pathfinding",
        "Tactical strategy games",
        "Warehouse robot navigation",
        "Search and rescue operations",
        "Urban path planning"
      ],

      "disadvantages": [
        "Primarily optimized for uniform-cost grids",
        "Complex implementation compared to A*",
        "Less effective in highly constrained environments",
        "Not suitable for weighted terrain (use A* instead)"
      ],

      "related_algorithms": [
