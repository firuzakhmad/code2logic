    "complexity": {
      "time_best": "O(V + E)",
      "time_average": "O(V + E)",
      "time_worst": "O(V + E)",
      "space": "O(V)",
      "explanation": "BFS explores all vertices and edges exactly once. Space complexity is O(V) for the queue and visited set."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": false,
      "comparison_based": false,
      "online": false,
      "recursive": false,
      "parallelizable": true,
      "deterministic": true
    },

    "description": {
      "brief": "Breadth-First Search (BFS) is a graph traversal algorithm that explores vertices in order of their distance from the source vertex.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O(V + E) - visit each vertex and edge once",
        "Space Complexity: O(V) - for queue and visited set",
        "",
        "Key Characteristics:",
        "• Explores graph level by level",
        "• Finds shortest path in unweighted graphs",
        "• Can be used for cycle detection",
        "• Foundation for many graph algorithms",
        "",
        "Applications:",
        "• Shortest path in unweighted graphs",
        "• Web crawling (page rank)",
        "• Social network analysis",
        "• GPS navigation systems",
        "• Puzzle solving (Rubik's Cube, 8-puzzle)"
      ],

      "pseudocode": [
        "void BFS(",
        "       const Graph& graph, ",
        "       size_t start_node, ",
        "       optional<size_t> target_node)",
        "{",
        "    Queue<size_t> queue;",
        "    vector<bool> visited(graph.node_count, false);",
        "    vector<bool> inQueue(graph.node_count, false);",
        "    vector<size_t> parent(graph.node_count, INVALID_NODE);",
        "    vector<int> distance(graph.node_count, -1);",
        "",
        "    queue.push(start_node);",
        "    inQueue[start_node] = true;",
        "    distance[start_node] = 0;",
        "",
        "    while (!queue.empty())",
        "    {",
        "        size_t current_node = queue.front();",
        "        queue.pop();",
        "        inQueue[current_node] = false;",
        "",
        "        if (!visited[current_node])",
        "        {",
        "            visited[current_node] = true;",
        "",
        "            if (target_node.has_value() &&",
        "                current_node == target_node.value())",
        "            {",
        "                break;",
        "            }",
        "",
        "            for (size_t neighbor : graph.adjacencyList[current_node])",
        "            {",
        "                if (!visited[neighbor] && !inQueue[neighbor])",
        "                {",
        "                    queue.push(neighbor);",
        "                    inQueue[neighbor] = true;",
        "                    parent[neighbor] = current_node;",
        "                    distance[neighbor] = distance[current_node] + 1;",
        "                }",
        "            }",
        "        }",
        "    }",
        "}"
      ],

      "optimizations": [
        "Use bitset for visited in dense graphs",
        "Bidirectional BFS for faster path finding",
        "Parallel BFS for large graphs",
        "Early termination when target found"
      ],

      "use_cases": [
        "Finding shortest path in unweighted graphs",
        "Web crawling and indexing",
        "Social network friend suggestions",
        "GPS shortest route (unweighted)",
        "Puzzle solving",
        "Network broadcast routing"
      ],

      "disadvantages": [
        "Requires O(V) memory",
        "Not suitable for weighted graphs (use Dijkstra)",
        "Can be slower than DFS for deep graphs",
        "May explore many nodes unnecessarily"
      ],

      "related_algorithms": [
        "Depth-First Search (DFS)",
        "Dijkstra's Algorithm",
        "A* Search",
        "Bidirectional Search"
      ]
    },

