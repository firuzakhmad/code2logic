    "complexity": {
      "time_best": "O((V + E) log V)",
      "time_average": "O((V + E) log V)",
      "time_worst": "O((V + E) log V)",
      "space": "O(V)",
      "explanation": "Dijkstra uses a priority queue for efficient extraction of minimum distance nodes. Time complexity is O((V + E) log V) with a binary heap. Space complexity is O(V) for storing distances and the priority queue."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": false,
      "comparison_based": true,
      "online": false,
      "recursive": false,
      "parallelizable": false,
      "deterministic": true
    },

    "description": {
      "brief": "Dijkstra's algorithm finds the shortest path from a start node to all other nodes in a weighted graph with non-negative edge weights.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O((V + E) log V) with binary heap",
        "Space Complexity: O(V) for distances and priority queue",
        "",
        "Key Characteristics:",
        "• Guarantees shortest path in weighted graphs",
        "• Works with non-negative edge weights only",
        "• Explores nodes in order of increasing distance from start",
        "• Can be stopped early when target is reached",
        "",
        "Applications:",
        "• GPS navigation systems",
        "• Network routing protocols (OSPF, IS-IS)",
        "• Social network analysis",
        "• Game AI pathfinding"
      ],

      "pseudocode": [
        "vector<Cell> Dijkstra(",
        "       const Grid& grid,",
        "       Cell start,",
        "       Cell target)",
        "{",
        "    PriorityQueue<Cell, float> pq;",
        "    vector<vector<bool>> in_pq(rows, vector<bool>(cols, false));",
        "    vector<vector<bool>> visited(rows, vector<bool>(cols, false));",
        "    vector<vector<Cell>> came_from(rows, vector<Cell>(cols));",
        "    vector<vector<float>> dist(rows, vector<float>(cols, INFINITY));",
        "",
        "    dist[start.row][start.col] = 0;",
        "    pq.push(start, 0);",
        "    in_pq[start.row][start.col] = true;",
        "",
        "    while (!pq.empty())",
        "    {",
        "        Cell current = pq.pop_min();",
        "        in_pq[current.row][current.col] = false;",
        "",
        "        if (current == target)",
        "        {",
        "            break;",
        "        }",
        "",
        "        visited[current.row][current.col] = true;",
        "",
        "        for (const Cell& neighbor : get_neighbors(current))",
        "        {",
        "            if (visited[neighbor.row][neighbor.col]) continue;",
        "            if (grid[neighbor.row][neighbor.col] == WALL) continue;",
        "",
        "            float alt = dist[current.row][current.col] +",
        "                movement_cost(current, neighbor);",
        "",
        "            if (alt < dist[neighbor.row][neighbor.col])",
        "            {",
        "                came_from[neighbor.row][neighbor.col] = current;",
        "                dist[neighbor.row][neighbor.col] = alt;",
        "",
        "                if (!in_pq[neighbor.row][neighbor.col])",
        "                {",
        "                    pq.push(neighbor, alt);",
        "                    in_pq[neighbor.row][neighbor.col] = true;",
        "                }",
        "            }",
        "        }",
        "    }",
        "",
        "    return reconstruct_path(came_from, start, target);",
        "}"
      ],

      "optimizations": [
        "Binary heap for priority queue",
        "Early termination when target is reached",
        "Bidirectional Dijkstra for faster pathfinding",
        "A* with heuristic for better guidance"
      ],

      "use_cases": [
        "GPS and mapping applications",
        "Network routing protocols",
        "Robotics path planning with terrain costs",
        "Game AI for weighted maps"
      ],

      "disadvantages": [
        "Cannot handle negative edge weights",
        "Explores many nodes unnecessarily when target is known",
        "Slower than A* when a good heuristic is available",
        "Memory usage can be high for large graphs"
      ],

      "related_algorithms": [
        "A* Algorithm",
        "Bellman-Ford (handles negative weights)",
        "Floyd-Warshall (all-pairs shortest paths)",
        "BFS (unweighted graphs)"
      ]
    },

