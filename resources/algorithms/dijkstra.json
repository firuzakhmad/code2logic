    "description": {
      "brief": "Dijkstra's algorithm finds the shortest paths from a source node to all other nodes in a weighted graph with non-negative edge weights.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O((V + E) log V) - with binary heap",
        "Space Complexity: O(V) - for distances and priority queue",
        "",
        "Key Characteristics:",
        "• Finds shortest paths from source to all vertices",
        "• Works with non-negative edge weights",
        "• Uses greedy approach with priority queue",
        "• Foundation for many routing protocols",
        "",
        "Applications:",
        "• GPS navigation and mapping",
        "• Network routing (OSPF, IS-IS)",
        "• Social network analysis",
        "• Game AI pathfinding",
        "• Resource allocation problems"
      ],

      "pseudocode": [
        "void Dijkstra(",
        "       const Graph& graph,",
        "       size_t source_node,",
        "       optional<size_t> target_node)",
        "{",
        "    PriorityQueue<size_t, int> pq;",
        "    vector<int> dist(graph.node_count, INFINITY);",
        "    vector<size_t> prev(graph.node_count, INVALID_NODE);",
        "    vector<bool> visited(graph.node_count, false);",
        "    vector<bool> in_pq(graph.node_count, false);",
        "",
        "    dist[source_node] = 0;",
        "    pq.push(source_node, 0);",
        "    in_pq[source_node] = true;",
        "",
        "    while (!pq.empty())",
        "    {",
        "        size_t current_node = pq.pop_min();",
        "        in_pq[current_node] = false;",
        "",
        "        if (visited[current_node]) continue;",
        "        visited[current_node] = true;",
        "",
        "        if (target_node.has_value() &&",
        "            current_node == target_node.value())",
        "        {",
        "            break;",
        "        }",
        "",
        "        for (const Edge& edge : graph.adjacencyList[current_node])",
        "        {",
        "            size_t neighbor = edge.to;",
        "            int weight = edge.weight;",
        "            int new_dist = dist[current_node] + weight;",
        "",
        "            if (new_dist < dist[neighbor])",
        "            {",
        "                dist[neighbor] = new_dist;",
        "                prev[neighbor] = current_node;",
        "                pq.push(neighbor, new_dist);",
        "                in_pq[neighbor] = true;",
        "            }",
        "        }",
        "    }",
        "}"
      ],

