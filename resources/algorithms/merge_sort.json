    "complexity": {
      "time_best": "O(n log n)",
      "time_average": "O(n log n)",
      "time_worst": "O(n log n)",
      "space": "O(n)",
      "explanation": "Merge Sort is a divide-and-conquer algorithm that divides the array into halves, recursively sorts them, and then merges the sorted halves. It guarantees O(n log n) performance regardless of input."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": false,
      "comparison_based": true,
      "online": false,
      "recursive": true,
      "parallelizable": true,
      "deterministic": true
    },

    "description": {
      "brief": "A stable, divide-and-conquer sorting algorithm that divides the array into halves, recursively sorts them, and merges the sorted halves.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity:",
        "• Best case:    O(n log n) - always",
        "• Average case: O(n log n) - always",
        "• Worst case:   O(n log n) - always",
        "",
        "Space Complexity: O(n) - requires auxiliary array for merging",
        "",
        "Key Characteristics:",
        "• Stable sort (maintains relative order of equal elements)",
        "• Guaranteed O(n log n) performance",
        "• Well-suited for linked lists",
        "• Parallelizable (can merge independently)",
        "",
        "Performance Metrics:",
        "• Comparisons: n log n",
        "• Copies: n log n",
        "• Memory: O(n) auxiliary space"
      ],

      "pseudocode": [
        "void merge_sort(std::vector<int>& arr, int left, int right)",
        "{",
        "     if (left >= right)",
        "     {",
        "         return;",
        "     }",
        "",
        "     int mid = left + (right - left) / 2;",
        "     ",
        "     merge_sort(arr, left, mid);",
        "     merge_sort(arr, mid + 1, right);",
        "     ",
        "     merge(arr, left, mid, right);",
        "}",
        "",
        "void merge(std::vector<int>& arr, int left, int mid, int right)",
        "{",
        "     int n1 = mid - left + 1;",
        "     int n2 = right - mid;",
        "     ",
        "     vector<int> left_arr(n1), right_arr(n2);",
        "     ",
        "     for (int i = 0; i < n1; i++)",
        "         left_arr[i] = arr[left + i];",
        "     for (int j = 0; j < n2; j++)",
        "         right_arr[j] = arr[mid + 1 + j];",
        "     ",
        "     int i = 0, j = 0, k = left;",
        "     ",
        "     while (i < n1 && j < n2)",
        "     {",
        "         if (left_arr[i] <= right_arr[j])",
        "         {",
        "             arr[k] = left_arr[i];",
        "             i++;",
        "         }",
        "         else",
        "         {",
        "             arr[k] = right_arr[j];",
        "             j++;",
        "         }",
        "         k++;",
        "     }",
        "     ",
        "     while (i < n1)",
        "     {",
        "         arr[k] = left_arr[i];",
        "         i++; k++;",
        "     }",
        "     ",
        "     while (j < n2)",
        "     {",
        "         arr[k] = right_arr[j];",
        "         j++; k++;",
        "     }",
        "}"
      ],

      "optimizations": [
