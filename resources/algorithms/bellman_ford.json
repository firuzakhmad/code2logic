    "complexity": {
      "time_best": "O(E)",
      "time_average": "O(V * E)",
      "time_worst": "O(V * E)",
      "space": "O(V)",
      "explanation": "Bellman-Ford relaxes all edges V-1 times. Best case O(E) when early termination occurs. Space complexity O(V) for distances."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": true,
      "comparison_based": true,
      "online": false,
      "recursive": false,
      "parallelizable": false,
      "deterministic": true
    },

    "description": {
      "brief": "Bellman-Ford finds shortest paths from a source vertex to all other vertices in a weighted graph, handling negative edge weights and detecting negative cycles.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O(V * E) - worst case V-1 relaxations of all edges",
        "Space Complexity: O(V) - for distance and predecessor arrays",
        "",
        "Key Characteristics:",
        "• Handles negative edge weights unlike Dijkstra",
        "• Detects negative cycles in the graph",
        "• More versatile but slower than Dijkstra",
        "• Can be optimized with early termination",
        "",
        "Applications:",
        "• Distance-vector routing protocols (RIP, BGP)",
        "• Currency arbitrage detection",
        "• Network flow optimization",
        "• Graph analysis with negative weights"
      ],

      "pseudocode": [
        "void BellmanFord(",
        "       const Graph& graph,",
        "       size_t source_node,",
        "       optional<size_t> target_node)",
        "{",
        "    vector<int> dist(graph.node_count, INFINITY);",
        "    vector<size_t> prev(graph.node_count, INVALID_NODE);",
        "    vector<bool> reached(graph.node_count, false);",
        "",
        "    dist[source_node] = 0;",
        "    reached[source_node] = true;",
        "",
        "    for (int i = 0; i < graph.node_count - 1; i++)",
        "    {",
        "        bool updated = false;",
        "",
        "        for (const Edge& edge : graph.edges)",
        "        {",
        "            if (dist[edge.from] < INFINITY &&",
        "                dist[edge.from] + edge.weight < dist[edge.to])",
        "            {",
        "                dist[edge.to] = dist[edge.from] + edge.weight;",
        "                prev[edge.to] = edge.from;",
        "                reached[edge.to] = true;",
        "                updated = true;",
        "",
        "                if (target_node.has_value() &&",
        "                    edge.to == target_node.value())",
        "                {",
        "                    return;",
        "                }",
        "            }",
        "        }",
        "",
        "        if (!updated) break;",
        "    }",
        "",
        "    for (const Edge& edge : graph.edges)",
        "    {",
        "        if (dist[edge.from] < INFINITY &&",
        "            dist[edge.from] + edge.weight < dist[edge.to])",
        "        {",
        "            // Negative cycle detected",
        "            return;",
        "        }",
        "    }",
        "}"
      ],

      "optimizations": [
        "Early termination when no distance updates occur",
        "Queue-based SPFA (Shortest Path Faster Algorithm) for better average performance",
        "Yen's optimization for sparse graphs",
        "Parallel relaxation for large graphs"
      ],

      "use_cases": [
        "Distance-vector routing protocols (RIP)",
        "Currency arbitrage detection in forex markets",
        "Network flow with negative edge costs",
        "Checking for negative cycles in graphs"
      ],

      "disadvantages": [
        "Slow O(V*E) time complexity for dense graphs",
        "Not suitable for very large graphs",
        "SPFA variant is often faster in practice"
      ],

      "related_algorithms": [
        "Dijkstra's Algorithm (non-negative weights only)",
        "SPFA (Shortest Path Faster Algorithm)",
        "Floyd-Warshall Algorithm (all-pairs)",
        "Johnson's Algorithm (all-pairs with negative weights)"
      ]
