    "last_updated": "2026-05-12",

    "complexity": {
      "time_best": "O(E)",
      "time_average": "O((V + E) log V)",
      "time_worst": "O((V + E) log V)",
      "space": "O(V)",
      "explanation": "A* uses a priority queue with heuristic function. Time complexity depends on heuristic quality. Space complexity is O(V) for open/closed sets."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": false,
      "comparison_based": true,
      "online": false,
      "recursive": false,
      "parallelizable": false,
      "deterministic": true
    },

    "description": {
      "brief": "A* is an informed graph traversal algorithm that uses a heuristic to efficiently find the shortest path from source to target.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O((V + E) log V) - with good heuristic",
        "Space Complexity: O(V) - for open and closed sets",
        "",
        "Key Characteristics:",
        "• Uses heuristic to guide search toward target",
        "• Combines Dijkstra's optimality with greedy best-first speed",
        "• Requires admissible heuristic for optimality",
        "• Admissible heuristics: Euclidean distance, Manhattan distance",
        "",
        "Applications:",
        "• Video game pathfinding",
        "• Robotics navigation",
        "• GPS routing",
        "• Network routing optimization",
        "• Puzzle solving (15-puzzle, 8-puzzle)"
      ],

      "pseudocode": [
        "void AStar(",
        "       const Graph& graph,",
        "       size_t source_node,",
        "       size_t target_node)",
        "{",
        "    PriorityQueue<Node, float> open_set;",
        "    vector<bool> in_open_set(graph.node_count, false);",
        "    vector<bool> closed_set(graph.node_count, false);",
        "    vector<size_t> came_from(graph.node_count, INVALID_NODE);",
        "    vector<float> g_score(graph.node_count, INFINITY);",
        "    vector<float> f_score(graph.node_count, INFINITY);",
        "",
        "    g_score[source_node] = 0;",
        "    f_score[source_node] = heuristic(source_node, target_node);",
        "    open_set.push(source_node, f_score[source_node]);",
        "    in_open_set[source_node] = true;",
        "",
        "    while (!open_set.empty())",
        "    {",
        "        size_t current_node = open_set.pop_min();",
        "        in_open_set[current_node] = false;",
        "",
        "        if (current_node == target_node)",
        "        {",
        "            break;",
        "        }",
        "",
        "        closed_set[current_node] = true;",
        "",
        "        for (const Edge& edge : graph.adjacencyList[current_node])",
        "        {",
        "            size_t neighbor = edge.to;",
        "            int weight = edge.weight;",
        "",
        "            if (closed_set[neighbor]) continue;",
        "",
        "            float tentative_g_score = g_score[current_node] + weight;",
        "",
        "            if (tentative_g_score < g_score[neighbor])",
        "            {",
        "                came_from[neighbor] = current_node;",
        "                g_score[neighbor] = tentative_g_score;",
        "                f_score[neighbor] = g_score[neighbor] +",
        "                    heuristic(neighbor, target_node);",
        "",
        "                if (!in_open_set[neighbor])",
        "                {",
        "                    open_set.push(neighbor, f_score[neighbor]);",
        "                    in_open_set[neighbor] = true;",
        "                }",
        "            }",
        "        }",
        "    }",
        "}"
      ],

      "optimizations": [
        "Use binary heap for priority queue",
        "Tie-breaking strategies for better performance",
        "Bidirectional A* for large graphs",
        "Jump Point Search for grid-based graphs",
        "Dynamic weighting for faster search"
      ],

      "use_cases": [
