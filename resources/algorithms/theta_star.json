  "algorithm": {
    "id": "theta_star",
    "name": "Theta* Any-Angle Pathfinding",
    "display_type": "Theta*",
    "category": "Path Finding",
    "version": "1.0.0",
    "last_updated": "2026-05-20",

    "complexity": {
      "time_best": "O(E log V)",
      "time_average": "O(E log V)",
      "time_worst": "O(E log V)",
      "space": "O(V)",
      "explanation": "Theta* has the same complexity as A* but with additional line-of-sight checks. Time complexity is O(E log V) where E is edges and V is vertices. Space complexity is O(V)."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": false,
      "comparison_based": true,
      "online": false,
      "recursive": false,
      "parallelizable": false,
      "deterministic": true
    },

    "description": {
      "brief": "Theta* is an any-angle pathfinding algorithm that produces shorter and more natural paths by allowing movement across grid cells using line-of-sight checks.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O(E log V) with line-of-sight checks",
        "Space Complexity: O(V) for open/closed sets",
        "",
        "Key Characteristics:",
        "• Produces shorter paths than A* on grids",
        "• Uses line-of-sight to skip intermediate nodes",
        "• Creates natural any-angle movement",
        "• Same complexity as A* with LOS overhead",
        "",
        "Applications:",
        "• Real-time strategy games",
        "• Robotics navigation",
        "• Character movement in games",
        "• Any situation requiring smooth paths"
      ],

      "pseudocode": [
        "vector<Cell> ThetaStar(",
        "       const Grid& grid,",
        "       Cell start,",
        "       Cell target)",
        "{",
        "    PriorityQueue<Cell, float> open_set;",
        "    vector<vector<bool>> closed_set(rows, vector<bool>(cols, false));",
        "    vector<vector<Cell>> parent(rows, vector<Cell>(cols));",
        "    vector<vector<float>> g_score(rows, vector<float>(cols, INFINITY));",
        "",
        "    g_score[start.row][start.col] = 0;",
        "    parent[start.row][start.col] = start;",
        "    open_set.push(start, heuristic(start, target));",
        "",
        "    while (!open_set.empty())",
        "    {",
        "        Cell current = open_set.pop_min();",
        "",
        "        if (current == target)",
        "        {",
        "            break;",
        "        }",
        "",
        "        closed_set[current.row][current.col] = true;",
        "",
        "        for (const Cell& neighbor : get_neighbors(current))",
        "        {",
        "            if (closed_set[neighbor.row][neighbor.col]) continue;",
        "            if (grid[neighbor.row][neighbor.col] == WALL) continue;",
        "",
        "            // Theta* key difference: check line of sight to parent",
        "            Cell current_parent = parent[current.row][current.col];",
        "            ",
        "            if (line_of_sight(current_parent, neighbor))",
        "            {",
        "                // Path through parent (any-angle)",
        "                tentative_g = g_score[current_parent.row][current_parent.col] +",
        "                    distance(current_parent, neighbor);",
        "                ",
        "                if (tentative_g < g_score[neighbor.row][neighbor.col])",
        "                {",
        "                    parent[neighbor.row][neighbor.col] = current_parent;",
        "                    g_score[neighbor.row][neighbor.col] = tentative_g;",
        "                    f_score = tentative_g + heuristic(neighbor, target);",
        "                    open_set.push(neighbor, f_score);",
        "                }",
        "            }",
        "            else",
        "            {",
        "                // Standard A* path through current",
        "                tentative_g = g_score[current.row][current.col] +",
        "                    distance(current, neighbor);",
        "                ",
        "                if (tentative_g < g_score[neighbor.row][neighbor.col])",
        "                {",
        "                    parent[neighbor.row][neighbor.col] = current;",
        "                    g_score[neighbor.row][neighbor.col] = tentative_g;",
        "                    f_score = tentative_g + heuristic(neighbor, target);",
        "                    open_set.push(neighbor, f_score);",
        "                }",
        "            }",
        "        }",
        "    }",
        "",
        "    return reconstruct_path(parent, start, target);",
        "}"
      ],

      "optimizations": [
        "Early line-of-sight termination",
        "Bresenham's line algorithm for LOS checks",
        "Lazy Theta* for fewer LOS checks",
        "Memory-efficient parent tracking"
      ],

      "use_cases": [
        "Real-time strategy game unit movement",
        "Robotic path planning with smooth turns",
        "First-person shooter NPC navigation",
        "Autonomous vehicle path planning"
      ],

      "disadvantages": [
        "More expensive than A* due to LOS checks",
        "LOS checks can be costly on large grids",
        "Path can cut very close to obstacles",
        "More complex implementation than A*"
      ],

      "related_algorithms": [
        "A* Algorithm",
        "Lazy Theta*",
        "Jump Point Search",
        "Dijkstra's Algorithm"
      ]
    },

