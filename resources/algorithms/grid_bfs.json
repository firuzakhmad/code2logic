  "algorithm": {
    "id": "grid_bfs",
    "name": "Breadth-First Search",
    "display_type": "BFS",
    "category": "Path Finding",
    "version": "1.0.0",
    "last_updated": "2026-05-20",

    "complexity": {
      "time_best": "O(V + E)",
      "time_average": "O(V + E)",
      "time_worst": "O(V + E)",
      "space": "O(V)",
      "explanation": "BFS explores all vertices at the current depth before moving deeper. Time complexity is O(V + E) where V is vertices and E is edges. Space complexity is O(V) for the queue and visited set."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": false,
      "comparison_based": false,
      "online": false,
      "recursive": false,
      "parallelizable": true,
      "deterministic": true
    },

    "description": {
      "brief": "Breadth-First Search finds the shortest path in unweighted grids by exploring cells level by level from the start.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O(V + E) where V = rows*cols, E = edges",
        "Space Complexity: O(V) for queue and visited tracking",
        "",
        "Key Characteristics:",
        "• Guarantees shortest path in unweighted grids",
        "• Explores cells in order of increasing distance from start",
        "• Uses a queue (FIFO) for frontier management",
        "• Simple and intuitive to understand",
        "",
        "Applications:",
        "• Unweighted shortest path finding",
        "• Social network friend recommendations",
        "• Web crawling",
        "• Puzzle solving (Rubik's cube, sliding puzzles)"
      ],

      "pseudocode": [
        "vector<Cell> BFS(",
        "       const Grid& grid,",
        "       Cell start,",
        "       Cell target)",
        "{",
        "    queue<Cell> frontier;",
        "    vector<vector<bool>> visited(rows, vector<bool>(cols, false));",
        "    vector<vector<bool>> in_frontier(rows, vector<bool>(cols, false));",
        "    vector<vector<Cell>> came_from(rows, vector<Cell>(cols));",
        "",
        "    frontier.push(start);",
        "    in_frontier[start.row][start.col] = true;",
        "",
        "    while (!frontier.empty())",
        "    {",
        "        Cell current = frontier.pop_front();",
        "        in_frontier[current.row][current.col] = false;",
        "        visited[current.row][current.col] = true;",
        "",
        "        if (current == target)",
        "        {",
        "            break;",
        "        }",
        "",
        "        for (const Cell& neighbor : get_neighbors(current))",
        "        {",
        "            if (visited[neighbor.row][neighbor.col]) continue;",
        "            if (in_frontier[neighbor.row][neighbor.col]) continue;",
        "            if (grid[neighbor.row][neighbor.col] == WALL) continue;",
        "",
        "            came_from[neighbor.row][neighbor.col] = current;",
        "            frontier.push(neighbor);",
        "            in_frontier[neighbor.row][neighbor.col] = true;",
        "        }",
        "    }",
        "",
        "    return reconstruct_path(came_from, start, target);",
        "}"
      ],

      "optimizations": [
        "Bidirectional BFS for faster pathfinding",
        "Early termination when target is found",
        "Bit-packed visited arrays for memory efficiency",
        "Parallel BFS for large graphs"
      ],

      "use_cases": [
        "Shortest path in unweighted grids",
        "Social network friend suggestions",
        "Web crawler link discovery",
        "Puzzle solving algorithms"
      ],

      "disadvantages": [
        "Does not handle weighted edges",
        "Memory usage grows exponentially with branching factor",
        "Less efficient than A* when heuristic is available",
        "Explores many nodes unnecessarily for large grids"
      ],

      "related_algorithms": [
        "DFS (Depth-First Search)",
        "Dijkstra's Algorithm (weighted graphs)",
        "A* Algorithm (with heuristic)",
        "Bidirectional BFS"
      ]
    },

