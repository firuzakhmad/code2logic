    "last_updated": "2026-05-17",

    "complexity": {
      "time_best": "O(E)",
      "time_average": "O((V + E) log V)",
      "time_worst": "O((V + E) log V)",
      "space": "O(V)",
      "explanation": "Grid A* uses a priority queue with heuristic function. Time complexity depends on heuristic quality. Space complexity is O(V) for open/closed sets."
    },

    "properties": {
      "stable": true,
      "in_place": false,
      "adaptive": false,
      "comparison_based": true,
      "online": false,
      "recursive": false,
      "parallelizable": false,
      "deterministic": true
    },

    "description": {
      "brief": "Grid A* is an informed pathfinding algorithm for grid-based maps that uses heuristics to efficiently find the shortest path.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O((V + E) log V) - with good heuristic",
        "Space Complexity: O(V) - for open and closed sets",
        "",
        "Key Characteristics:",
        "• Uses heuristic to guide search toward target",
        "• Combines Dijkstra's optimality with greedy best-first speed",
        "• Supports 4-directional and 8-directional movement",
        "• Handles weighted terrain (different movement costs)",
        "",
        "Applications:",
        "• Video game pathfinding",
        "• Robotics navigation",
        "• GPS routing on grid maps",
        "• Maze solving"
      ],

      "pseudocode": [
        "vector<Cell> GridAStar(",
        "       const Grid& grid,",
        "       Cell start,",
        "       Cell target)",
        "{",
        "    PriorityQueue<Cell, float> open_set;",
        "    vector<vector<bool>> in_open_set(rows, vector<bool>(cols, false));",
        "    vector<vector<bool>> closed_set(rows, vector<bool>(cols, false));",
        "    vector<vector<Cell>> came_from(rows, vector<Cell>(cols));",
        "    vector<vector<float>> g_score(rows, vector<float>(cols, INFINITY));",
        "    vector<vector<float>> f_score(rows, vector<float>(cols, INFINITY));",
        "",
        "    g_score[start.row][start.col] = 0;",
        "    f_score[start.row][start.col] = heuristic(start, target);",
        "    open_set.push(start, f_score[start.row][start.col]);",
        "    in_open_set[start.row][start.col] = true;",
        "",
        "    while (!open_set.empty())",
        "    {",
        "        Cell current = open_set.pop_min();",
        "        in_open_set[current.row][current.col] = false;",
        "",
        "        if (current == target)",
        "        {",
        "            break;",
        "        }",
        "",
        "        closed_set[current.row][current.col] = true;",
        "",
        "        for (const Cell& neighbor : get_neighbors(current))",
        "        {",
        "            if (closed_set[neighbor.row][neighbor.col]) continue;",
        "            if (grid[neighbor.row][neighbor.col] == WALL) continue;",
        "",
        "            float tentative_g_score = g_score[current.row][current.col] +",
        "                movement_cost(current, neighbor);",
        "",
        "            if (tentative_g_score < g_score[neighbor.row][neighbor.col])",
        "            {",
        "                came_from[neighbor.row][neighbor.col] = current;",
        "                g_score[neighbor.row][neighbor.col] = tentative_g_score;",
        "                f_score[neighbor.row][neighbor.col] = g_score[neighbor.row][neighbor.col] +",
        "                    heuristic(neighbor, target);",
        "",
        "                if (!in_open_set[neighbor.row][neighbor.col])",
        "                {",
        "                    open_set.push(neighbor, f_score[neighbor.row][neighbor.col]);",
        "                    in_open_set[neighbor.row][neighbor.col] = true;",
        "                }",
        "            }",
        "        }",
        "    }",
        "",
        "    return reconstruct_path(came_from, start, target);",
        "}"
      ],

      "optimizations": [
        "Binary heap for priority queue",
        "Tie-breaking strategies for better performance",
        "Jump Point Search for uniform grids",
        "HPA* (Hierarchical Pathfinding A*) for large maps"
      ],

      "use_cases": [
        "Real-time strategy games",
        "Robotics navigation",
        "GPS navigation systems",
        "Maze solving",
        "Autonomous vehicle path planning"
      ],

      "disadvantages": [
        "Requires good heuristic for optimal performance",
        "Memory usage can be high for large grids",
        "8-directional movement requires sqrt(2) cost for diagonal moves"
      ],

      "related_algorithms": [
