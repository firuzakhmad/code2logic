      "deterministic": true
    },

    "description": {
      "brief": "Topological Sort orders vertices in a Directed Acyclic Graph (DAG) such that for every directed edge u→v, u comes before v.",

      "detailed": [
        "Algorithm Analysis:",
        "──────────────────",
        "Time Complexity: O(V + E) - each vertex and edge processed once",
        "Space Complexity: O(V) - for queue and indegree array",
        "",
        "Key Characteristics:",
        "• Works only on Directed Acyclic Graphs (DAGs)",
        "• Kahn's algorithm uses indegree tracking",
        "• Multiple valid topological orders possible",
        "• Detects cycles in directed graphs",
        "",
        "Applications:",
        "• Build systems (make, Gradle, Maven)",
        "• Course prerequisite ordering",
        "• Task scheduling and dependency resolution",
        "• Deadlock detection in databases",
        "• Instruction scheduling in compilers"
      ],

      "pseudocode": [
        "vector<size_t> TopologicalSort(",
        "       const Graph& graph,",
        "       optional<size_t> target_node)",
        "{",
        "    vector<int> indegree(graph.node_count, 0);",
        "    vector<size_t> result;",
        "    vector<bool> processed(graph.node_count, false);",
        "    Queue<size_t> queue;",
        "",
        "    for (const Edge& edge : graph.edges)",
        "    {",
        "        indegree[edge.to]++;",
        "    }",
        "",
        "    for (size_t i = 0; i < graph.node_count; i++)",
        "    {",
        "        if (indegree[i] == 0)",
        "        {",
        "            queue.push(i);",
        "            processed[i] = true;",
        "        }",
        "    }",
        "",
        "    while (!queue.empty())",
        "    {",
        "        size_t current = queue.pop();",
        "        result.push_back(current);",
        "",
        "        if (target_node.has_value() &&",
        "            current == target_node.value())",
        "        {",
        "            return result;",
        "        }",
        "",
        "        for (size_t neighbor : graph.adjacencyList[current])",
        "        {",
        "            indegree[neighbor]--;",
        "",
        "            if (indegree[neighbor] == 0 &&",
        "                !processed[neighbor])",
        "            {",
        "                queue.push(neighbor);",
        "                processed[neighbor] = true;",
        "            }",
        "        }",
        "    }",
        "",
        "    if (result.size() != graph.node_count)",
        "    {",
        "        // Cycle detected",
        "        result.clear();",
        "    }",
        "",
        "    return result;",
        "}"
      ],

      "optimizations": [
        "Early termination when target node is found",
        "DFS-based topological sort for recursive scenarios",
